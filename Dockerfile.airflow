# Airflow with project dependencies
# Airflow 2.8.1 requires Python ≤3.11; do NOT bump to 3.13
FROM apache/airflow:2.8.1-python3.11

# Install project dependencies (tomli not needed — stdlib tomllib used)
RUN pip install --no-cache-dir \
    "pyarrow>=15,<19" \
    "numpy>=1.26,<2" \
    "httpx>=0.27,<1" \
    "duckdb>=1.0,<2" \
    "scipy>=1.12,<2"
