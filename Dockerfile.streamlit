# Streamlit Dashboard for Portfolio Optimization

FROM python:3.13-slim

# Install uv
RUN pip install uv

WORKDIR /app

# Install dashboard dependencies
RUN uv pip install --system \
    streamlit>=1.28.0 \
    plotly>=5.0.0 \
    pandas>=2.0.0 \
    requests>=2.32.5

# Copy source code
COPY src/dashboard/ ./src/dashboard/

# Set environment
ENV PYTHONPATH="/app"

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "src/dashboard/app.py", "--server.address", "0.0.0.0", "--server.port", "8501"]
