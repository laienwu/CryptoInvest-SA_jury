# Airflow
AIRFLOW_FERNET_KEY=change-me-generate-with-python-fernet
AIRFLOW_SECRET_KEY=change-me-random-string
AIRFLOW_ADMIN_PASSWORD=admin

# Airflow Postgres
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Benchmarks Postgres
BENCHMARKS_DB_HOST=postgres-benchmarks
BENCHMARKS_DB_PORT=5432
BENCHMARKS_DB_NAME=portfolio_benchmarks
BENCHMARKS_DB_USER=portfolio
BENCHMARKS_DB_PASSWORD=portfolio123

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC=klines-raw

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=portfolio-data

# Redis (API cache)
REDIS_URL=redis://redis:6379/0

# Automated trading — Binance testnet ONLY (mainnet is hard-blocked at the client layer).
# Get keys from https://testnet.binance.vision/ → "Log In with GitHub" → "API Keys".
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Default posture is dry-run (no real orders). Flip to "false" only after a clean rehearsal.
TRADING_DRY_RUN=true
